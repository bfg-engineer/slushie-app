# Copy this file to .env.local for running on your own computer.
# On Vercel, add these under Project > Settings > Environment Variables.

# Your Anthropic API key (console.anthropic.com > API Keys). Starts with sk-ant-
ANTHROPIC_API_KEY=

# The password you type to log in to your slushie app. Pick anything.
APP_PASSWORD=

# Postgres connection string. Vercel fills this in automatically when you
# add a Neon database from the Vercel Marketplace (Storage tab).
DATABASE_URL=
